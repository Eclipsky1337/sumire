{
  "name": "sumire-web-editor",
  "private": true,
  "scripts": {
    "lint": "eslint *.js",
    "build": "npm run lint && esbuild main.js --bundle --minify --format=iife --target=es2022 --outfile=../assets/web/app.js",
    "check": "npm run build && git diff --exit-code -- ../assets/web/app.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.11.3",
    "@codemirror/lint": "6.8.5",
    "@codemirror/state": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.38.1",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.8.0"
  }
}
